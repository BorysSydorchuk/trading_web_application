# Copy to .env and adjust. Never commit .env.

# Postgres (docker-compose uses the POSTGRES_* values; the app uses the URLs)
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal
POSTGRES_DB=trading_journal
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://journal:journal@127.0.0.1:5432/trading_journal
TEST_DATABASE_URL=postgresql+psycopg://journal:journal@127.0.0.1:5432/trading_journal_test

# App
APP_ENV=dev
LOG_DIR=logs
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173

# AI (used from M2)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# MT5 investor passwords (from M1): one key per account, referenced by account.password_ref
# MT5_PASSWORD_FN_P1=
