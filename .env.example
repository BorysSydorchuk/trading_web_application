# Copy to .env and adjust. Never commit .env.

# Postgres (docker-compose uses the POSTGRES_* values; the app uses the URLs)
  POSTGRES_USER=journal
  POSTGRES_PASSWORD=journal
  POSTGRES_DB=trading_journal
  POSTGRES_PORT=5432
  DATABASE_URL=postgresql+psycopg://journal:journal@127.0.0.1:5432/trading_journal
  TEST_DATABASE_URL=postgresql+psycopg://journal:journal@127.0.0.1:5432/trading_journal_test

# App
  APP_ENV=dev
  LOG_DIR=logs
  LOG_LEVEL=INFO
  API_HOST=127.0.0.1
  API_PORT=8000
  FRONTEND_PORT=5173

# AI (M2). Empty key = app still starts; "Заповнити з тексту" shows "ШІ не налаштовано", manual form works.
  # A new key needs an app restart.
  ANTHROPIC_API_KEY=
  # Trade/bias extraction (mid-tier, PRD 5).
  ANTHROPIC_MODEL_EXTRACTION=claude-sonnet-5-5
  # Optional weekly/monthly AI summary (M6, unused until then).
  ANTHROPIC_MODEL_SUMMARY=claude-opus-5-5
  # One attempt on this model after the extraction model failed with overload/5xx/timeout/connection.
  ANTHROPIC_MODEL_FALLBACK=claude-opus-5-5
  # low | medium | high (extraction is a mapping task; low is faster and cheaper)
  ANTHROPIC_EFFORT=medium

# MT5 investor passwords (from M1): one line per account, key = MT5_PASSWORD_<login>
#   MT5_PASSWORD_<login>=<investor password>
# Use the INVESTOR (read-only) password, never the master/trading password.
# The worker reads it to log in to MT5; it is never stored in the DB, never logged
# and never sent to the browser (the UI only shows whether the key is set).
# Example for login 12345678 (uncomment and fill in):
# MT5_PASSWORD_12345678=

# Worker data source: "real" (default, MetaTrader5 terminals) or "fixture:<path to JSON>"
# to run the worker without a terminal (demo/QA), e.g.
# MT5_SOURCE=fixture:backend/tests/fixtures/mt5/basic_week.json
# MT5_SOURCE=real

# Telegram bot (planned)
  TELEGRAM_BOT_TOKEN=

# Notion export (planned)
  NOTION_TOKEN=

# Whisper
  WHISPER_MODEL=small
  WHISPER_COMPUTE_TYPE=int8
  WHISPER_LANGUAGE=uk
  WHISPER_BEAM_SIZE=5
  WHISPER_CPU_THREADS=0
  DATA_DIR=data
